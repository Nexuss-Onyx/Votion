{
  "name": "@votion/sync-client",
  "version": "0.1.0",
  "private": true,
  "description": "Votion local-first client engine: normalized Zustand store, IndexedDB cache, optimistic transactions & persistent offline outbox",
  "author": "Nexuss-Onyx <tadd4212@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./transaction": {
      "types": "./dist/transaction/index.d.ts",
      "default": "./dist/transaction/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./presence": {
      "types": "./dist/presence/index.d.ts",
      "default": "./dist/presence/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@votion/types": "workspace:*",
    "dexie": "^4.4.7",
    "nanoid": "^6.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@votion/eslint-config": "workspace:*",
    "@votion/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
