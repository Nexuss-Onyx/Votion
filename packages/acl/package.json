{
  "name": "@votion/acl",
  "version": "0.1.0",
  "private": true,
  "description": "Votion hierarchical access control, permission traversal, Redis ACL caching, and public web sharing gateway",
  "author": "Nexuss-Onyx <tadd4212@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:traversal": "vitest run test/traversal.test.ts",
    "test:overrides": "vitest run test/overrides.test.ts",
    "test:public": "vitest run test/public.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@votion/db": "workspace:*",
    "@votion/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@votion/eslint-config": "workspace:*",
    "@votion/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
