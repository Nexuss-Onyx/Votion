{
  "name": "@votion/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Votion block editor canvas: recursive BlockCanvas, block wrappers, multi-column layouts, 15+ block renderers, slash menu, markdown shortcuts, drag-and-drop and multi-block selection",
  "author": "Nexuss-Onyx <tadd4212@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@votion/sync-client": "workspace:*",
    "@votion/types": "workspace:*",
    "@radix-ui/react-popover": "^1.1.6",
    "clsx": "^2.1.1",
    "zustand": "^5.1.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/katex": "^0.16.7",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@votion/eslint-config": "workspace:*",
    "@votion/typescript-config": "workspace:*",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
