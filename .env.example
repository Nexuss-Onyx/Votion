# ==========================================
# Database (Neon / Supabase Serverless Postgres 16)
# ==========================================
DATABASE_URL="postgresql://user:password@ep-votion-pooler.us-east-1.aws.neon.tech/votion?sslmode=require"

# PostgreSQL transport used by @votion/db:
#   neon-http      -> Wasmer Edge / serverless (stateless fetch)
#   neon-websocket -> long-running Node servers / migrations (pooled WebSocket)
#   node-postgres  -> local dev, CI and self-hosted Postgres (TCP)
VOTION_DB_DRIVER="neon-http"
# Maximum pool size for the pooled drivers (ignored by neon-http).
VOTION_DB_MAX_CONNECTIONS="10"

# ==========================================
# Cache & PubSub (Upstash Redis 7)
# ==========================================
REDIS_URL="rediss://default:password@votion-redis.upstash.io:6379"

# ==========================================
# Full-Text Search (Meilisearch Cloud)
# ==========================================
MEILISEARCH_HOST="https://ms-votion.meilisearch.io"
MEILISEARCH_API_KEY="your-meilisearch-master-key"

# ==========================================
# Object Storage (Cloudflare R2 / AWS S3)
# ==========================================
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_BUCKET_NAME="votion-media"
S3_PUBLIC_DOMAIN="https://media.votion.dev"

# ==========================================
# Real-Time Sync Worker (Phase 6)
# ==========================================
# Port the WebSocket gateway binds to (default 8080)
SYNC_WORKER_PORT="8080"
# Secret used to verify the JWTs clients present during the WS handshake
WS_JWT_SECRET="change-me-to-a-long-random-string"

# ==========================================
# Wasmer Edge Deployment Secrets
# ==========================================
WASMER_TOKEN="<YOUR_WASMER_TOKEN>"
